# Binance Web3 Wallet API (Build) - copy to .env.local and fill in.
# Server-side only: do NOT add a NEXT_PUBLIC_ prefix to any of these.

# X-OC-APIKEY header value, issued from web3.binance.com dev portal.
BINANCE_WEB3_API_KEY=

# HMAC-SHA256 secret used to sign requests (X-OC-SIGN).
BINANCE_WEB3_SECRET_KEY=

# Build API base URL (leave as-is unless the docs change).
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# --- Rebalancing agent wallet (execution layer) -----------------------------
# The agent signs its OWN transactions, so it holds its own key. Use a BRAND-NEW
# burner wallet, never your main wallet. Fund it with a tiny float only when you
# are ready to broadcast a real rebalance (see docs/agent-wallet.md). Until a key
# is set AND the mode below is "live", the app runs simulate-only and never
# broadcasts. Server-side only: never add a NEXT_PUBLIC_ prefix.

# 0x-prefixed private key of the burner agent wallet.
AGENT_WALLET_PRIVATE_KEY=

# Public BSC RPC used to simulate and (when enabled) broadcast. Default is fine.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Execution safety switch: "simulate" (default, never broadcasts) or "live".
# Even in "live", every broadcast still needs an explicit per-action go-ahead.
AGENT_EXECUTION_MODE=simulate
